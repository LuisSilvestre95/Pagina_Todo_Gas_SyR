# ---- Servidor ----
PORT=3000
HOST=0.0.0.0
SITE_URL=https://luissilvestre95.github.io/Pagina_Todo_Gas_SyR
# Pon TRUST_PROXY=true si el sitio está detrás de Nginx, Cloudflare, Render, Railway, etc.
TRUST_PROXY=false
# Carpeta donde se guardan las solicitudes (por defecto ./data)
# DATA_DIR=/var/lib/todogas

# ---- Panel /admin.html ----
# Token largo y aleatorio. Genera uno con:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# ---- Límite de envíos del formulario por IP ----
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# ---- Correo (opcional: requiere `npm install`) ----
# Ejemplo Outlook/Hotmail: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TODO GAS SYR <todogassyr@hotmail.com>"
MAIL_TO=todogassyr@hotmail.com

# ---- Webhook (opcional): Slack, Google Chat, Make, Zapier, n8n... ----
WEBHOOK_URL=

# Número de WhatsApp al que se redirige al cliente tras enviar (formato internacional sin +)
WHATSAPP_NUMBER=573209485534
